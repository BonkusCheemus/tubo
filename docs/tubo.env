# tubo: the environment of the served configuration behind the current
# numbers in BENCHMARKS.md (Qwen3.8-27B, DFlash2 drafter, turbo6 KV).
# One line per key: what it does. Boolean switches are on only at exactly "1".
# These are developer switches; names can change between versions.
# Replace every <...> with your own path. The "engine-only" benchmark in
# BENCHMARKS.md uses this file minus every line whose key contains TURBO
# (fp16 KV), and without the NPU lines when no NPU stack is installed.
#
# Load it with: set -a; . docs/tubo.env; set +a
# Build needed: see REPRODUCE.md (GUFO_T4_PREFETCH on, the CMake default;
# GUFO_ENABLE_NPU=ON for the GUFO_NPU_* lines).

# --- model and template ---
# Render re-quantized Qwen3.8 GGUFs that ship an edited chat template with the native Qwen3.8 profile instead of refusing them.
GUFO_DEV_ALLOW_UNPINNED_QWEN38_TEMPLATE=1

# --- weights and decode kernels ---
# Copy the weights into GPU-visible (GTT) memory at load instead of registering the mapped host pages.
GUFO_DEV_WEIGHTS_GTT=1
# Small-batch (verify widths 1-8) GEMM cells use the geometries measured fastest per (format, width, shape); bit-exact.
GUFO_DEV_SMALLBATCH_TUNED=1
# Faster IQ-format small-batch and GEMV kernels.
GUFO_DEV_IQ_FAST=1
# K-quant v3 half-super-block kernel for the table cells where it measured >= 3% faster (int8 activations).
GUFO_DEV_KQUANT_V3=1
# Strix-native (SN) layout for IQ3 FFN gate+up: byte-exact load-time repack; needs GUFO_DEV_SN_IQ3_SERVE=1 too.
GUFO_SN_K4=iq3
# Serve the SN IQ3 gate/up kernels (one activation scale per 256 values; not bit-exact to the native IQ3 path).
GUFO_DEV_SN_IQ3_SERVE=1
# Run IQ3_S / IQ3_XXS gate+up as one packed projection.
GUFO_DEV_IQ3_PACKED=1
# Prefill: same-type IQ3 gate+up as one dual GEMM (lets the NPU split take their rows).
GUFO_DEV_IQ3_DUAL_GU=1
# Prefill: that IQ3 dual gate/up with the commit-stage decoder; same bytes.
GUFO_DEV_IQ3_CS=1
# Fused tiny verify projections (attention K+V, SSM alpha+beta, shared activation quantize) in one launch each; bitwise equal.
GUFO_DEV_SMALL_K95=1
# Embedding rows read from an SSD file instead of RAM (about 1 GB less RAM); make the file with tools/qwen27b/export_embedding_rows.
GUFO_DEV_EMBED_SSD=<path to the model's .embrows file>

# --- KV cache ---
# [KV] Quantized block KV cache (Turbo family) for the 27B path.
GUFO_DEV_TURBO4_KV=1
# [KV] Bits per value of that cache: 4, 5 or 6 (turbo6 = 6.125 bits with the scale).
GUFO_DEV_TURBO_KV_BITS=6
# [KV] Use the block KV cache in decode.
GUFO_DEV_TURBO4_DECODE=1
# [KV] Use the block KV cache in prefill.
GUFO_DEV_TURBO4_PREFILL=1
# Multi-row Turbo verify reader through the WMMA tile kernel.
GUFO_DEV_TURBO4_VERIFY_WMMA=1
# Turbo5/Turbo6 verify reads each K/V block once for every draft row (wide WMMA reader).
GUFO_DEV_VERIFY_WMMA_WIDE=1
# Turbo6 verify attention reader with Q in registers (needs the GUFO_T4_PREFETCH build); bitwise equal to the WMMA reader.
GUFO_DEV_ATTN6_V3=1
# 0 = keep the WMMA reader's split plan (another value changes the merge order, so output is close, not bitwise).
GUFO_DEV_ATTN6_SPLITS=0
# Turbo6 verify reader: conflict-free centroid table, hoisted PV fragments, live-row softmax; bitwise equal.
GUFO_DEV_ATTN_C=1
# Rotate a verify sequence's rows in one batched RoPE launch; bitwise equal.
GUFO_DEV_BATCHED_VERIFY_ROPE=1
# Prefill: wave32 Turbo KV dequantizer; byte-identical output.
GUFO_DEV_DEQ_V2=1
# Size the Turbo f16 prefill scratch from the prefilled prefix instead of the whole --context (RAM); same bytes.
GUFO_DEV_SCRATCH_TILED=1

# --- speculative round (DFlash2 drafter) ---
# Keep the drafter's fc/K/V weights quantized at pack time instead of packing them dense.
GUFO_DEV_DFLASH_KEEP_QUANT=1
# Give the drafter sidecar's file pages back to the page cache after packing (RAM).
GUFO_DEV_DFLASH_DROP_PAGECACHE=1
# Drafter attention, split route that cuts the KV re-read; bit-exact.
GUFO_DEV_DRAFTK=2
# Drafter selector: compile-time top-k (level 1) plus the reduction in its own kernel (level 2); bit-exact.
GUFO_DEV_WSTRAG=1
# Skip host waits whose only consumer is later work on the same stream.
GUFO_DEV_NO_EXTRA_SYNC=1
# Pass verify feature rows by reference instead of copying them on the host.
GUFO_DEV_HOSTOPS=1
# Hand the target's feature rows to the drafter on the device (no host round trip).
GUFO_DEV_HOSTOPS_FEAT=1
# Keep the retained frontier as a row index into the verify logits, not a host copy.
GUFO_DEV_HOSTOPS_FRONTIER=1
# Log the per-round draft length line (diagnostics only).
GUFO_DEV_DRAFT_LEN_LOG=1

# --- optional GPU+NPU prefill split (XDNA2 NPU; build with GUFO_ENABLE_NPU=ON) ---
# The compiled NPU GEMM kernel; its instruction files sit beside it. Unset = GPU only.
GUFO_NPU_SPLIT=<path to the NPU GEMM .xclbin>
# 0 = skip the XRT buffer sync call.
GUFO_NPU_BO_SYNC=0
# Largest prefill chunk (rows of tokens) sent to the NPU.
GUFO_NPU_MAX_M=4096
# ffn_down rows the NPU computes (multiple of 256).
GUFO_NPU_ROWS=1536
# gate/up rows each the NPU computes (multiple of 128).
GUFO_NPU_GU_ROWS=7424
# Percent of the rows of the attention input projections the NPU computes.
GUFO_NPU_STORE_PCT=35
# Packed-weight cache file for the NPU: the first prefill pass writes it, later passes read it from disk.
GUFO_NPU_BCACHE=<path to an NPU B-cache file, created on first use>
# The B-cache keys carry the logical tensor tag (needed with the IQ3 dual gate/up).
GUFO_NPU_BCACHE_TAGGED=1

# Not set on purpose:
# - HSA_OVERRIDE_GFX_VERSION: gfx1151 is reported natively, so it changes nothing.
# - GUFO_DEV_SSM_NO_SNAPSHOT: no longer read; the copy-free recurrent-state
#   rollback is always on.
